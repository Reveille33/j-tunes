{
  "name": "j-tunes",
  "version": "0.2.8",
  "description": "A streamlined, highly performant desktop podcast manager and player.",
  "main": "./out/main/index.js",
  "author": "j-Tunes",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "screenshots": "npm run build && node --experimental-strip-types scripts/screenshots.ts"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.26",
    "better-sqlite3": "13.2.0",
    "fast-xml-parser": "5.12.1",
    "music-metadata": "12.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "playwright": "1.65.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
